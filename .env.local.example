# Copy to .env.local (never commit it). Server-side only: none of these reach the browser.
# Full reference: docs/engineering/DEPLOYMENT.md

# --- Required ---------------------------------------------------------------
# Groq API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Model ID. There is no default in code, so retiring a model is a configuration change.
# Check https://console.groq.com/docs/models and /docs/deprecations before changing it.
GROQ_MODEL=openai/gpt-oss-120b

# --- Optional: AI ------------------------------------------------------------
# AI_PROVIDER=groq
# GROQ_REASONING_EFFORT=low
# Overall generation deadline in ms (5000-55000). Must stay below the route's 60 s limit.
# AI_TIMEOUT_MS=50000
# Upper bound for the per-request output cap (1000 + 600 per trip day).
# AI_MAX_OUTPUT_TOKENS=10000

# --- Optional: budgets (set below your Groq plan's daily limits) --------------
# Free plan: 1,000 requests and 200,000 tokens per day per model.
# AI_DAILY_REQUEST_BUDGET=900
# AI_DAILY_TOKEN_BUDGET=180000

# --- Optional: per-visitor limits and cache -----------------------------------
# RATE_LIMIT_PER_MINUTE=5
# RATE_LIMIT_PER_DAY=30
# Groq tokens per visitor per day (stops one visitor using the whole daily budget).
# RATE_LIMIT_TOKENS_PER_DAY=30000
# Seconds an identical request is served from the cache. 0 disables the cache.
# CACHE_TTL_SECONDS=86400

# --- Optional: shared store (Upstash Redis) -----------------------------------
# Without these, limits and cache live in each server instance's memory.
# The Vercel Marketplace integration sets KV_REST_API_URL / KV_REST_API_TOKEN, which also work.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Optional: owner endpoints ------------------------------------------------
# Enables GET /api/usage and GET /api/health?probe=ai (Authorization: Bearer <token>).
# At least 32 random characters; a shorter value is ignored.
# ADMIN_TOKEN=
