# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code project files are shared (they are excluded by a global ignore file on some machines)
!CLAUDE.md
!.claude/
.claude/settings.local.json

# test and design output (regenerate with npm run test:e2e and scripts/screenshots.mjs)
/test-results/
/playwright-report/
/docs/design/screenshots/

# editor settings
/.vscode/

*.md